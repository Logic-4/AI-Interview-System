# Only track frontend/, backend/, and services/ — everything else at the
# repo root (docs, notes, .claude/.agents config, graphify-out cache, etc.)
# is intentionally kept out of git.
*

!frontend/
!frontend/**
!backend/
!backend/**
!services/
!services/**
!.gitignore
!package.json
!docker-compose.yml

# Node/Next modules and builds
node_modules/
.next/
out/
build/
dist/

# Environment local files (do not commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Speech model files (large files, 60MB+)
*.onnx
*.onnx.json

# Logs & temp files
*.log

# Python cache & runtime logs
__pycache__/
*.pyc
.ipynb_checkpoints/
*.pyo
*.pyd
.venv/
venv/
env/

# OS files
.DS_Store
Thumbs.db
